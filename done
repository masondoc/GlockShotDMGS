<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>SOLID CROW: SHADOW OPERATION</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Share+Tech+Mono&display=swap" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
            touch-action: manipulation;
            margin: 0;
            padding: 0;
        }
        body {
            background-color: #030708;
            color: #00ff66;
            font-family: 'Share Tech Mono', monospace;
            overflow: hidden;
            width: 100vw;
            height: 100vh;
        }

        #game-container {
            position: relative;
            width: 100vw;
            height: 100vh;
            background: #000;
            overflow: hidden;
        }

        canvas#viewport {
            width: 100%;
            height: 100%;
            display: block;
            image-rendering: pixelated;
        }

        /* CRT Scanline Effect */
        .crt-overlay {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%);
            background-size: 100% 4px;
            pointer-events: none;
            z-index: 10;
            opacity: 0.6;
        }

        /* MGS Soliton Radar HUD */
        #radar-container {
            position: absolute;
            top: 15px;
            right: 15px;
            width: 160px;
            height: 160px;
            background: rgba(4, 24, 12, 0.85);
            border: 2px solid #00ff66;
            border-radius: 8px;
            box-shadow: 0 0 12px rgba(0, 255, 102, 0.3);
            z-index: 20;
            overflow: hidden;
        }
        #radar-canvas {
            width: 100%;
            height: 100%;
        }

        /* DOOM-Style Status Bar HUD */
        #doom-hud {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 70px;
            background: linear-gradient(180deg, #111a13 0%, #050b07 100%);
            border-top: 3px solid #00ff66;
            z-index: 25;
            display: flex;
            align-items: center;
            justify-content: space-around;
            padding: 0 10px;
            box-shadow: 0 -4px 15px rgba(0,0,0,0.8);
        }

        .hud-block {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #00ff66;
            font-family: 'Press Start 2P', monospace;
        }
        .hud-label {
            font-size: 9px;
            color: #88ccaa;
            margin-bottom: 3px;
        }
        .hud-val {
            font-size: 18px;
            text-shadow: 0 0 6px rgba(0,255,102,0.6);
        }

        /* Crow Doom Face Frame */
        #face-frame {
            width: 54px;
            height: 54px;
            border: 2px solid #00ff66;
            background: #08140c;
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
        }

        /* Fortnite Mobile Touch Controls Layer */
        #touch-controls {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none;
            z-index: 30;
            display: none; /* Auto toggled for touch devices */
        }

        /* Fortnite Action Buttons */
        .touch-btn {
            position: absolute;
            pointer-events: auto;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-family: 'Share Tech Mono', monospace;
            box-shadow: 0 4px 10px rgba(0,0,0,0.5), inset 0 0 8px rgba(255,255,255,0.3);
            border: 2px solid rgba(255,255,255,0.6);
            backdrop-filter: blur(4px);
            user-select: none;
            -webkit-user-select: none;
        }
        .touch-btn:active {
            transform: scale(0.92);
        }

        #btn-fire {
            right: 25px; bottom: 90px; width: 75px; height: 75px;
            background: rgba(220, 38, 38, 0.75); color: #fff; font-size: 16px;
        }
        #btn-box {
            right: 110px; bottom: 85px; width: 60px; height: 60px;
            background: rgba(217, 119, 6, 0.75); color: #fff; font-size: 13px;
        }
        #btn-crouch {
            right: 180px; bottom: 85px; width: 55px; height: 55px;
            background: rgba(16, 185, 129, 0.75); color: #fff; font-size: 12px;
        }
        #btn-interact {
            right: 35px; bottom: 180px; width: 58px; height: 58px;
            background: rgba(59, 130, 246, 0.75); color: #fff; font-size: 13px;
        }
        #btn-weapon {
            right: 105px; bottom: 155px; width: 52px; height: 52px;
            background: rgba(139, 92, 246, 0.75); color: #fff; font-size: 11px;
        }
        #btn-knock {
            right: 165px; bottom: 150px; width: 50px; height: 50px;
            background: rgba(236, 72, 153, 0.75); color: #fff; font-size: 11px;
        }

        /* Virtual Touch Joystick */
        #joystick-zone {
            position: absolute;
            left: 20px;
            bottom: 85px;
            width: 140px;
            height: 140px;
            pointer-events: auto;
        }
        #joystick-base {
            width: 100%;
            height: 100%;
            background: rgba(255, 255, 255, 0.1);
            border: 2px solid rgba(0, 255, 102, 0.5);
            border-radius: 50%;
            position: relative;
        }
        #joystick-thumb {
            width: 50px;
            height: 50px;
            background: rgba(0, 255, 102, 0.8);
            border: 2px solid #fff;
            border-radius: 50%;
            position: absolute;
            top: 45px;
            left: 45px;
            box-shadow: 0 0 10px rgba(0,255,102,0.8);
        }

        /* MGS Codec System Overlay */
        #codec-screen {
            position: absolute;
            inset: 0;
            background: rgba(2, 12, 6, 0.95);
            z-index: 50;
            display: none;
            flex-direction: column;
            justify-content: space-between;
            padding: 20px;
            border: 4px solid #00ff66;
            box-shadow: inset 0 0 30px rgba(0,255,102,0.3);
        }
        .codec-header {
            text-align: center;
            font-family: 'Press Start 2P', monospace;
            color: #00ff66;
            font-size: 16px;
            border-bottom: 2px dashed #00ff66;
            padding-bottom: 10px;
        }
        .codec-portraits {
            display: flex;
            justify-content: space-around;
            align-items: center;
            margin: 20px 0;
        }
        .portrait-box {
            width: 130px;
            height: 150px;
            border: 2px solid #00ff66;
            background: #04140a;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: relative;
            box-shadow: 0 0 15px rgba(0,255,102,0.2);
        }
        .portrait-avatar {
            font-size: 60px;
            margin-bottom: 10px;
        }
        .portrait-name {
            font-family: 'Press Start 2P', monospace;
            font-size: 10px;
            color: #00ff66;
        }
        .codec-freq {
            font-family: 'Press Start 2P', monospace;
            color: #33ffff;
            font-size: 22px;
            text-shadow: 0 0 10px #33ffff;
        }
        .codec-dialogue {
            background: rgba(0, 30, 15, 0.8);
            border: 2px solid #00ff66;
            padding: 15px;
            border-radius: 6px;
            min-height: 110px;
            font-size: 16px;
            line-height: 1.4;
            color: #d1ffd6;
            position: relative;
        }
        .codec-next-btn {
            margin-top: 10px;
            align-self: flex-end;
            background: #00ff66;
            color: #000;
            font-weight: bold;
            padding: 8px 18px;
            border-radius: 4px;
            cursor: pointer;
            font-family: 'Press Start 2P', monospace;
            font-size: 11px;
        }

        /* Banner Messages */
        #alert-banner {
            position: absolute;
            top: 25px;
            left: 50%;
            transform: translateX(-50%);
            font-family: 'Press Start 2P', monospace;
            font-size: 24px;
            color: #ff2222;
            text-shadow: 0 0 10px #ff0000;
            display: none;
            z-index: 22;
            animation: blink 0.4s infinite alternate;
        }
        @keyframes blink { from { opacity: 1; } to { opacity: 0.2; } }

        /* Game Start Screen */
        #start-screen {
            position: absolute;
            inset: 0;
            background: #020905;
            z-index: 100;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 20px;
            text-align: center;
        }
    </style>
</head>
<body>
    <div id="game-container">
        <!-- CRT Overlay -->
